  "abstract": [
    {
      "id": "ES2002a.rdhillon.s.1",
      "text": "The project manager introduced the upcoming project to the team members and then the team members participated in an exercise in which they drew their favorite animal and discussed what they liked about the animal."
    },
    {
      "id": "ES2002a.rdhillon.s.2",
      "text": "The project manager talked about the project finances and selling prices."
    },
    {
      "id": "ES2002a.rdhillon.s.3",
      "text": "The team then discussed various features to consider in making the remote."
    }
  ],
  "actions": [
    {
      "id": "ES2002a.rdhillon.s.4",
      "text": "The industrial designer will work on the working design of the remote."
    },
    {
      "id": "ES2002a.rdhillon.s.5",
      "text": "The user interface designer will work on the technical functions of the remote."
    },
    {
      "id": "ES2002a.rdhillon.s.6",
      "text": "The marketing executive will work on what requirements the remote has to fulfill"
    }
  ],
  "decisions": [
    {
      "id": "ES2002a.rdhillon.s.7",
      "text": "The remote will sell for 25 Euro."
    },
    {
      "id": "ES2002a.rdhillon.s.8",
      "text": "The remote will be sold on an international scale."
    },
    {
      "id": "ES2002a.rdhillon.s.9",
      "text": "The production costs cannot exceed 12.50 Euro."
    }
  ],
  "problems": [
    {
      "id": "ES2002a.rdhillon.s.10",
      "text": "Whether the remote will be used exclusively for televisions."
    }
  ],
