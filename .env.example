# Copy to .env only if you need overrides; the app reads process environment.
METAWISPR_DATA_DIR=data
METAWISPR_ASR_DIR=models/sherpa-onnx-nemo-parakeet-tdt-0.6b-v2-int8
METAWISPR_OLLAMA_URL=http://127.0.0.1:11434
METAWISPR_REFINER_MODEL=qwen3.5:4b
METAWISPR_DOCUMENTER_MODEL=qwen3.5:9b
METAWISPR_MAX_UPLOAD_MB=200
METAWISPR_MAX_AUDIO_SECONDS=7200
METAWISPR_ASR_THREADS=4
METAWISPR_CHUNK_SECONDS=30
METAWISPR_DECODE_TIMEOUT_SECONDS=180
METAWISPR_MAX_PENDING_JOBS=3
# Optional: path to a system FFmpeg; otherwise use imageio-ffmpeg's bundled binary.
# METAWISPR_FFMPEG=C:/path/to/ffmpeg.exe
METAWISPR_LLM_CONTEXT=8192
