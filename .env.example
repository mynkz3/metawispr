# Copy to .env only if you need overrides; the app reads process environment.
METAWISPR_DATA_DIR=data
METAWISPR_ASR_DIR=models/sherpa-onnx-nemo-parakeet-tdt-0.6b-v2-int8
# CUDA requires the matching sherpa-onnx GPU wheel and working CUDA/cuDNN DLLs.
METAWISPR_ASR_PROVIDER=cuda
# METAWISPR_ASR_PRECISION=int8
METAWISPR_OLLAMA_URL=http://127.0.0.1:11434
# Gemini sends transcript text to Google; the API key belongs in the server environment.
METAWISPR_LLM_BACKEND=gemini
METAWISPR_REFINER_MODEL=gemini-3.8-flash
METAWISPR_DOCUMENTER_MODEL=gemini-3.8-flash
# Gemini credentials may also be read from the ignored repository .env file.
# GEMINI_API_KEY=replace-in-your-private-server-environment-or-env-file
# To return to Qwen: backend=ollama and both model tags=qwen3.5:4b.
METAWISPR_MAX_UPLOAD_MB=200
METAWISPR_MAX_AUDIO_SECONDS=7200
METAWISPR_ASR_THREADS=4
METAWISPR_CHUNK_SECONDS=30
METAWISPR_DECODE_TIMEOUT_SECONDS=180
METAWISPR_MAX_PENDING_JOBS=3
# Optional: path to a system FFmpeg; otherwise use imageio-ffmpeg's bundled binary.
# METAWISPR_FFMPEG=C:/path/to/ffmpeg.exe
METAWISPR_LLM_CONTEXT=16384
METAWISPR_LLM_OUTPUT_TOKENS=3072
METAWISPR_LLM_TIMEOUT_SECONDS=300
# Production workspace assets; build frontend/ before starting the server.
METAWISPR_UI_DIR=frontend/dist
